# Project environment is shared with tools/project-env.sh. Keep the explicit
# served selection here as well: this is the repository's executable direnv
# contract and the static workstation-cutover gate intentionally reads it.
export SPRINTCTL_BACKEND=served
export SPRINTCTL_VUORO_PROFILE=/projects/dev/agentops/templates/dispatch/environment-record/profiles/workstation-vuoro-shared.json
unset SPRINTCTL_URL
_envrc_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "${_envrc_dir}/tools/project-env.sh"
unset _envrc_dir
