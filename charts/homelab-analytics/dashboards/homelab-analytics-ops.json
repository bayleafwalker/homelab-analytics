    },
    {
      "type": "row",
      "title": "Backups",
      "id": 22,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Consecutive backup failures",
      "id": 23,
