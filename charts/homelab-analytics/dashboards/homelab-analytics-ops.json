      "type": "timeseries",
      "title": "Worker dispatches (1h increase)",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(homelab_analytics_worker_dispatches_total[1h]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
